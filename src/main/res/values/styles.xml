<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OneUI" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/oneui_primary</item>
        <item name="colorPrimaryDark">@color/oneui_primary_dark</item>
        <item name="colorAccent">@color/oneui_primary</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/oneui_white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="alertDialogTheme">@style/Theme.OneUI.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/Theme.OneUI.AlertDialog</item>
        <item name="dialogTheme">@style/Theme.OneUI.Dialog</item>
    </style>

    <style name="Theme.OneUI.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/oneui_splash_bg</item>
        <item name="android:statusBarColor">@color/splash_status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/oneui_white</item>
    </style>

    <style name="Theme.OneUI.Dialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <style name="Theme.OneUI.AlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@null</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="colorAccent">@color/oneui_primary</item>
        <item name="android:windowElevation">@android:dimen/app_icon_size</item>
    </style>

    <style name="Widget.OneUI.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/oneui_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
